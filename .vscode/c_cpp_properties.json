{
    "version": 4,
    "configurations": [
        {
            "name": "aarch64-cross",
            "includePath": [
                "${workspaceFolder}/include",
                "${workspaceFolder}/../axLib/include",
                "${workspaceFolder}/../axShell/include"
            ],
            "browse": {
                "path": [
                    "${workspaceFolder}/include",
                    "${workspaceFolder}/../axLib/include",
                    "${workspaceFolder}/../axShell/include",
                    "${workspaceFolder}/asm"
                ],
                "limitSymbolsToIncludedHeaders": true
            },
            "defines": [
                "__aarch64__"
            ],
            "compilerPath": "",
            "cStandard": "c11",
            "cppStandard": "c++17",
            "intelliSenseMode": "linux-gcc-arm64"
        }
    ]
}