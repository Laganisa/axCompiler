{
  "version": 4,
  "configurations": [
    {
      "name": "axCompiler",
      "includePath": [
        "${workspaceFolder}/include",
        "${workspaceFolder}/../axLib/include"
      ],
      "browse": {
        "path": [
          "${workspaceFolder}/include",
          "${workspaceFolder}/../axLib/include",
          "${workspaceFolder}/compiler",
          "${workspaceFolder}/asm"
        ],
        "limitSymbolsToIncludedHeaders": true
      },
      "defines": [
        "__aarch64__"
      ],
      "compilerPath": "aarch64-linux-gnu-gcc",
      "cStandard": "c11",
      "cppStandard": "c++17",
      "intelliSenseMode": "linux-gcc-arm64"
    }
  ]
}
